# ════════════════════════════════════════════════════════════════
# SAVAYA TIENDA — Variables de entorno
# Copia este archivo como .env.local y completa los valores reales
# NUNCA subas .env.local a Git (ya está en .gitignore)
# ════════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://savayavzla.com

# ── Supabase (proyecto NUEVO para Savaya — no reutilizar Tuluoshop) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # Solo backend, nunca NEXT_PUBLIC_

# ── Cloudinary ───────────────────────────────────────────────────
# Usar carpeta "savaya/" para separar assets de Tuluoshop
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── WhatsApp & Contacto ───────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=584141100100

# ── Meta Pixel + Conversions API ─────────────────────────────────
# MISMO Pixel ID que las campañas — toda la data al mismo lugar
NEXT_PUBLIC_META_PIXEL_ID=27355395054120748
META_PIXEL_ID=27355395054120748
META_CAPI_ACCESS_TOKEN=             # Solo backend

# ── Email (Resend) ────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=pedidos@savayavzla.com

# ── SEO & Revalidación ────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=      # GA4 Measurement ID (G-XXXXXXXXXX)
REVALIDATE_SECRET=                  # Protege /api/revalidate
SEED_SECRET=                        # Habilita /api/seed solo en desarrollo
